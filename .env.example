# Copy this file to .env. Keep real credentials out of source control.
PORT=3000
LOCAL_DB_PATH=.data/leaflore.sqlite

# Configure these once to provision the first local administrator.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_NAME=Store Admin
# INITIAL_ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters

# PayMongo test mode is the default. Checkout stays unavailable until these are set.
# PAYMONGO_MODE=test
# PAYMONGO_SECRET_KEY=sk_test_replace_me
# PAYMONGO_WEBHOOK_SECRET=replace_with_webhook_signing_secret
# PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
# PUBLIC_APP_URL=http://localhost:3000
